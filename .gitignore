# Local configuration, environments and editor state
.env
.env.*
!.env.example
.venv/
.venv-rag/
venv/
.idea/
.run/
.vscode/
.jbeval/
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Private material, reference checkouts and generated artifacts
/runtime/
/tmp/
/resume/
/reports/
/vendor/
/requirements.lock.txt
*.log
*.db
*.sqlite*
*.safetensors
*.pth
*.pt
*.onnx
*.download
*.part

# Publish the fixed source catalog and selected evaluation labels only
/data/**
!/data/paper_catalog.json
!/data/paper_manifest.json
!/data/evaluation/
!/data/evaluation/paper_benchmark/
!/data/evaluation/paper_benchmark/dev.jsonl
!/data/evaluation/paper_benchmark/heldout.jsonl
!/data/evaluation/paper_benchmark/test50.jsonl
!/data/evaluation/paper_benchmark/manifest.json
!/data/evaluation/paper_benchmark/test50_manifest.json
!/data/evaluation/formula_test50/
!/data/evaluation/formula_test50/curation.json
!/data/evaluation/formula_test50/questions.jsonl

# Public documentation is explicit; local learning notes stay local
/docs/*
!/docs/getting-started.md
!/docs/architecture.md
!/docs/evaluation.md
!/docs/data.md
!/docs/assets/
!/docs/benchmarks/
